// Схема данных TaskTracker.
// Провайдер по умолчанию — sqlite (запуск без внешней БД).
// Для продакшена меняется на postgresql вместе с драйвер-адаптером в src/lib/db.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Сотрудник: исполнитель задач и руководитель проектов.
/// Он же пользователь системы, если ему заведён пароль.
model Member {
  id           String    @id @default(cuid())
  fullName     String
  /// Имя для обращения: в справочнике «Сидоров Алексей», в приветствии
  /// «Алексей». Пусто — имя берётся из ФИО.
  displayName  String?
  email        String?   @unique
  position     String?
  isActive     Boolean   @default(true)
  /// Роль в системе: ADMIN или MEMBER. Права на данные одинаковые,
  /// администратор дополнительно ведёт пользователей и доступы.
  role         String    @default("MEMBER")
  /// Пароль для входа: scrypt-хеш. Пусто — сотрудник в справочнике, но не входит.
  passwordHash String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ownedProjects     Project[]            @relation("ProjectOwner")
  assignedTasks     Task[]               @relation("TaskAssignee")
  notes             Note[]
  ownedLetters      Letter[]             @relation("LetterOwner")
  ownedDocuments    Document[]           @relation("DocumentOwner")
  reports           WeeklyReport[]       @relation("ReportAuthor")
  sessions          Session[]
  attachments       Attachment[]         @relation("AttachmentAuthor")
  ownedMeetings     Meeting[]            @relation("MeetingOwner")
  referencePages    ReferencePage[]      @relation("ReferenceAuthor")
  meetings          MeetingParticipant[] @relation("MeetingParticipantMember")
  visibilityChanges VisibilityChange[]   @relation("VisibilityChangeAuthor")

  @@index([fullName])
}

/// Сессия входа. В браузере лежит случайный токен, в базе — только его хеш,
/// поэтому утечка базы не даёт войти под чужим именем.
model Session {
  id        String   @id @default(cuid())
  memberId  String
  tokenHash String   @unique
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([expiresAt])
}

/// Проект — верхний уровень, аналог отдельного листа в Excel.
model Project {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  status      String    @default("ACTIVE")
  startDate   DateTime?
  dueDate     DateTime?
  ownerId     String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner      Member?                 @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks      Task[]
  tracks     Track[]
  letters    Letter[]
  documents  Document[]
  meetings   Meeting[]
  references ReferencePage[]
  reports    WeeklyReport[]
  milestones CounterpartyMilestone[]

  @@index([status])
  @@index([dueDate])
}

/// Трек работ — справочник проекта. Пользователь заводит свои треки:
/// четыре из Excel (производственный, внутренний, внешний, юридический)
/// создаются вместе с проектом как обычные записи и так же правятся.
model Track {
  id         String   @id @default(cuid())
  projectId  String
  /// Код базового трека из Excel: по нему раскладывается импорт.
  /// У треков, заведённых руками, пусто.
  key        String?
  name       String
  /// Цвет в интерфейсе: blue, orange, red, green, purple, gray.
  color      String   @default("blue")
  sortOrder  Int      @default(0)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([projectId, name])
  @@index([projectId, sortOrder])
}

/// Задача — строка таблицы. Поддерживает вложенность (подзадачи).
model Task {
  id               String    @id @default(cuid())
  projectId        String
  number           Int
  title            String
  description      String?
  status           String    @default("TODO")
  priority         String    @default("MEDIUM")
  assigneeId       String?
  parentId         String?
  startDate        DateTime?
  dueDate          DateTime?
  completedAt      DateTime?
  estimateHours    Float?
  spentHours       Float?
  progress         Int       @default(0)
  sortOrder        Int       @default(0)
  externalKey      String?
  /// Признак публичного отображения: публичная запись попадает в отчёт
  /// руководству, служебная остаётся внутри системы. После создания признак
  /// меняет только администратор, и смена пишется в VisibilityChange.
  isPublic         Boolean   @default(true)
  /// Трек работ — запись справочника проекта.
  trackId          String
  /// Ответственный вне компании — в исходных таблицах это отдельная колонка.
  externalAssignee String?
  /// Ключ задачи во внешнем трекере (Jira и подобные): проставляется руками.
  externalTaskKey  String?
  /// Ход работы: в исходных таблицах статус ведётся свободным текстом с датами.
  progressNote     String?
  letterId         String?
  /// Встреча, из решения которой заведена задача.
  meetingId        String?
  /// Строчными буквами: название, описание, ход работы и ключи одной строкой.
  /// SQLite не умеет регистронезависимый поиск по кириллице, поэтому
  /// поисковая строка готовится при записи — как у письма.
  searchIndex      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  track       Track          @relation(fields: [trackId], references: [id])
  letter      Letter?        @relation(fields: [letterId], references: [id], onDelete: SetNull)
  meeting     Meeting?       @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  assignee    Member?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parent      Task?          @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  children    Task[]         @relation("Subtasks")
  notes       Note[]
  artifacts   TaskArtifact[]
  attachments Attachment[]

  @@unique([projectId, number])
  @@unique([projectId, externalKey])
  @@index([status])
  @@index([dueDate])
  @@index([assigneeId])
  @@index([trackId])
  @@index([searchIndex])
}

/// Артефакт задачи — то, чем работа подтверждается: карточка в ЭДО, задача в
/// Jira, документ системы, своя ссылка или просто значение. Пришёл на смену
/// одному полю «Результат»: артефактов у задачи бывает несколько.
model TaskArtifact {
  id        String   @id @default(cuid())
  taskId    String
  /// Вид: EDO_LINK, JIRA_LINK, SYSTEM_DOC, CUSTOM_LINK, CUSTOM_VALUE.
  kind      String   @default("CUSTOM_LINK")
  /// Подпись артефакта: чем он является в работе.
  label     String?
  /// Ссылка, идентификатор документа или произвольный текст — по виду.
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
}

/// Вложение — файл рядом с задачей, письмом или документом. Сам файл лежит на
/// диске (каталог задаётся переменной ATTACHMENTS_DIR), в базе только карточка.
model Attachment {
  id           String   @id @default(cuid())
  fileName     String
  mimeType     String?
  size         Int
  /// Имя файла в каталоге хранения.
  storageKey   String   @unique
  uploadedById String?
  createdAt    DateTime @default(now())

  taskId     String?
  letterId   String?
  documentId String?
  meetingId  String?

  uploadedBy Member?   @relation("AttachmentAuthor", fields: [uploadedById], references: [id], onDelete: SetNull)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  letter     Letter?   @relation(fields: [letterId], references: [id], onDelete: Cascade)
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  meeting    Meeting?  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([letterId])
  @@index([documentId])
  @@index([meetingId])
}

/// Встреча: повестка, участники, решения и материалы. Место под почтовое
/// приглашение заложено полями `invitationSentAt` и `materialsSentAt`,
/// сама отправка письмом — в бэклоге.
model Meeting {
  id               String    @id @default(cuid())
  projectId        String
  /// День встречи. Время хранится отдельно строкой «ЧЧ:ММ»: во встречах
  /// важен день, а часовые пояса в одном ведомстве не нужны.
  date             DateTime
  startTime        String?
  endTime          String?
  /// Место или ссылка на видеовстречу.
  place            String?
  kind             String    @default("WORKING")
  subject          String
  agenda           String?
  decisions        String?
  /// Кто вёл запись: обычно тот, кто оформляет решения.
  ownerId          String?
  /// Отметки о почте: заложены под приглашение и рассылку материалов.
  invitationSentAt DateTime?
  materialsSentAt  DateTime?
  /// Строчными буквами: тема, место, повестка и решения одной строкой.
  searchIndex      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner        Member?              @relation("MeetingOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  participants MeetingParticipant[]
  attachments  Attachment[]
  /// Задачи, заведённые из решений встречи.
  tasks        Task[]

  @@index([projectId, date])
  @@index([date])
  @@index([searchIndex])
}

/// Участник встречи: свой сотрудник или представитель организации.
/// Заполнено ровно одно из полей, либо имя текстом — когда человека
/// в справочниках ещё нет.
model MeetingParticipant {
  id           String  @id @default(cuid())
  meetingId    String
  memberId     String?
  orgContactId String?
  /// Имя, если человека нет ни в сотрудниках, ни в представителях.
  externalName String?
  /// Отметка присутствия: приглашён и пришёл — разные вещи.
  attended     Boolean @default(true)

  meeting    Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member     Member?     @relation("MeetingParticipantMember", fields: [memberId], references: [id], onDelete: Cascade)
  orgContact OrgContact? @relation(fields: [orgContactId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

/// Ответственный представитель организации: реестр из требований.
model OrgContact {
  id             String   @id @default(cuid())
  counterpartyId String
  fullName       String
  position       String?
  email          String?
  phone          String?
  /// За что закреплён представитель: «подписание НДА», «сверка данных».
  comment        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  counterparty Counterparty         @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  meetings     MeetingParticipant[]

  @@index([counterpartyId])
  @@index([fullName])
}

/// Датированная запись хроники. В исходных таблицах колонка «Статус» содержит
/// не состояние, а хронику с датами — здесь она живёт без потерь.
/// Дата события отдельно от даты внесения: событие было пятого, записали седьмого.
model Note {
  id         String   @id @default(cuid())
  taskId     String?
  letterId   String?
  documentId String?
  authorId   String?
  body       String
  occurredOn DateTime
  createdAt  DateTime @default(now())

  task     Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  letter   Letter?   @relation(fields: [letterId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   Member?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, occurredOn])
  @@index([letterId, occurredOn])
  @@index([documentId, occurredOn])
}

/// Журнал импортов из Excel: что и когда загрузили, сколько строк принято.
model ImportBatch {
  id          String   @id @default(cuid())
  fileName    String
  projectId   String?
  rowsTotal   Int      @default(0)
  rowsCreated Int      @default(0)
  rowsUpdated Int      @default(0)
  rowsSkipped Int      @default(0)
  errorsJson  String?
  createdAt   DateTime @default(now())
}

/// Контрагент: ведомство, организация или подрядчик — адресат писем и сторона документов.
model Counterparty {
  id         String   @id @default(cuid())
  name       String   @unique
  shortName  String?
  isActive   Boolean  @default(true)
  /// Наша сторона: организация, которая ведёт реестр. Нужна, чтобы отличать
  /// «ждут нашей подписи» от «ждём другую сторону»: в матрице подписания
  /// соседний департамент — такая же внешняя сторона, как контрагент.
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  letters    Letter[]
  documents  Document[]
  signatures DocumentSignature[]
  aliases    CounterpartyAlias[]
  milestones CounterpartyMilestone[]
  contacts   OrgContact[]

  @@index([name])
}

/// Варианты написания организации из таблиц и писем. Нужны, чтобы импорт
/// схлопывал «ПАО "Россети Московский Регион"» и «ПАО Россети МР» в одну запись,
/// иначе отчёт по контрагенту не собрать.
model CounterpartyAlias {
  id             String @id @default(cuid())
  counterpartyId String
  alias          String @unique

  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@index([counterpartyId])
}

/// График интеграций: матрица «контрагент x этап». Строка исходного реестра —
/// организация, колонка — этап со своим плановым и фактическим сроком.
model CounterpartyMilestone {
  id             String    @id @default(cuid())
  projectId      String
  counterpartyId String
  stage          String
  sortOrder      Int       @default(0)
  plannedDate    DateTime?
  actualDate     DateTime?
  comment        String?

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@unique([projectId, counterpartyId, stage])
  @@index([projectId, plannedDate])
}

/// Письмо электронного документооборота — входящее или исходящее.
model Letter {
  id              String    @id @default(cuid())
  projectId       String
  number          String
  direction       String    @default("INCOMING")
  date            DateTime?
  subject         String
  url             String?
  counterpartyId  String?
  ownerId         String?
  dueDate         DateTime?
  status          String    @default("IN_PROGRESS")
  /// Исходный текст статуса из таблицы: он несёт детали, которых нет в справочнике.
  statusNote      String?
  /// Реквизиты ответа: номер и дата письма, которым закрыли это.
  responseRef     String?
  /// Резолюция по входящему письму: кому расписано и что поручено.
  resolution      String?
  /// Подписант исходящего письма.
  signatory       String?
  /// Ключ связанной задачи во внешнем трекере (Jira и подобные).
  externalTaskKey String?
  /// Признак публичного отображения: публичная запись попадает в отчёт
  /// руководству, служебная остаётся внутри системы. После создания признак
  /// меняет только администратор, и смена пишется в VisibilityChange.
  isPublic        Boolean   @default(false)
  comment         String?
  closedAt        DateTime?
  /// Письмо, ответом на которое является это: реестр ведёт переписку цепочками.
  responseToId    String?
  /// Строчными буквами: номер, тема, контрагент и комментарии одной строкой.
  /// SQLite не умеет регистронезависимый поиск по кириллице, поэтому
  /// поисковая строка готовится при записи.
  searchIndex     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project           Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  counterparty      Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  owner             Member?       @relation("LetterOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  responseTo        Letter?       @relation("LetterThread", fields: [responseToId], references: [id], onDelete: SetNull)
  responses         Letter[]      @relation("LetterThread")
  tasks             Task[]
  attachments       Attachment[]
  sentDocuments     Document[]    @relation("DocumentOutgoingLetter")
  receivedDocuments Document[]    @relation("DocumentIncomingLetter")
  notes             Note[]

  /// Номер письма повторяется в разные годы, поэтому дубль определяется
  /// парой «номер + дата», а не одним номером.
  @@unique([projectId, number, direction, date])
  @@index([status])
  @@index([dueDate])
  @@index([direction])
  @@index([searchIndex])
}

/// Юридически значимый документ: регламент, допсоглашение, контракт.
/// Подписание у каждой стороны ведётся отдельной записью DocumentSignature.
model Document {
  id               String    @id @default(cuid())
  projectId        String
  kind             String    @default("REGULATION")
  title            String
  counterpartyId   String?
  ownerId          String?
  status           String    @default("DRAFT")
  /// Итоговая формулировка из таблицы — там она развёрнутая, с причинами отказа.
  statusNote       String?
  /// Признак публичного отображения: публичная запись попадает в отчёт
  /// руководству, служебная остаётся внутри системы. После создания признак
  /// меняет только администратор, и смена пишется в VisibilityChange.
  isPublic         Boolean   @default(true)
  /// Что нужно сделать по документу прямо сейчас.
  nextAction       String?
  dueDate          DateTime?
  signedAt         DateTime?
  outgoingLetterId String?
  incomingLetterId String?
  /// Строчными буквами: название, организация и формулировка статуса одной
  /// строкой — SQLite не ищет по кириллице без учёта регистра.
  searchIndex      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  counterparty   Counterparty?       @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  owner          Member?             @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  outgoingLetter Letter?             @relation("DocumentOutgoingLetter", fields: [outgoingLetterId], references: [id], onDelete: SetNull)
  incomingLetter Letter?             @relation("DocumentIncomingLetter", fields: [incomingLetterId], references: [id], onDelete: SetNull)
  signatures     DocumentSignature[]
  notes          Note[]
  attachments    Attachment[]

  @@index([status])
  @@index([dueDate])
  @@index([kind])
  @@index([searchIndex])
}

/// Подпись одной стороны под документом. Документ согласуют несколько сторон,
/// и «подписан» он только тогда, когда подписали все обязательные.
model DocumentSignature {
  id             String    @id @default(cuid())
  documentId     String
  /// Название стороны: своя организация или контрагент.
  party          String
  counterpartyId String?
  status         String    @default("PENDING")
  /// Обязательна при отказе: без причины отказ нечем отработать.
  refusalReason  String?
  sentAt         DateTime?
  respondedAt    DateTime?
  signedAt       DateTime?
  /// Письмо-основание: чем документ ушёл стороне или чем она ответила.
  basisLetterId  String?
  url            String?
  note           String?
  sortOrder      Int       @default(0)

  document     Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  counterparty Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)

  @@unique([documentId, party])
  @@index([status])
}

/// Отчёт руководству за период: что сделано, что дальше, блокеры и решения.
model WeeklyReport {
  id          String    @id @default(cuid())
  projectId   String
  periodStart DateTime
  periodEnd   DateTime
  releaseInfo String?
  done        String?
  planned     String?
  blockers    String?
  solutions   String?
  /// DRAFT правится, SUBMITTED заморожен: иначе отправленный отчёт со временем
  /// покажет не то, что ушло руководству, и сверить его будет нечем.
  state       String    @default("DRAFT")
  submittedAt DateTime?
  authorId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  Member? @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([projectId, periodStart, periodEnd])
  @@index([periodEnd])
}

/// Справочная информация команды: архитектура системы, паспорт проекта,
/// матрица подписания. Страница может быть общей или привязанной к проекту.
model ReferencePage {
  id          String   @id @default(cuid())
  projectId   String?
  section     String   @default("OTHER")
  title       String
  content     String
  authorId    String?
  sortOrder   Int      @default(0)
  /// Строчными буквами: заголовок и содержание одной строкой.
  searchIndex String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  author  Member?  @relation("ReferenceAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([section])
  @@index([projectId])
  @@index([searchIndex])
}

/// Журнал смен видимости: после создания признак публичного отображения
/// меняет только администратор, и каждая правка остаётся в истории.
model VisibilityChange {
  id        String   @id @default(cuid())
  /// TASK, LETTER или DOCUMENT.
  entity    String
  entityId  String
  /// Название записи на момент правки: журнал читается и после удаления.
  title     String
  isPublic  Boolean
  memberId  String?
  createdAt DateTime @default(now())

  member Member? @relation("VisibilityChangeAuthor", fields: [memberId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}

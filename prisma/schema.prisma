// Модель данных TaskTracker.
// Пояснения к решениям — в docs/data-model.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Пространство и участники ──────────────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     Membership[]
  projects        Project[]
  labels          Label[]
  customFieldDefs CustomFieldDef[]
  activityLog     ActivityLog[]
  counterparties  Counterparty[]
  savedFilters    SavedFilter[]
  nonWorkingDays  NonWorkingDay[]
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  avatarUrl String?
  timeZone  String    @default("Europe/Moscow")
  lastSeenAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  memberships    Membership[]
  projectMembers ProjectMember[]
  assignments    TaskAssignee[]
  createdTasks   Task[]          @relation("TaskCreatedBy")
  comments       Comment[]
  timeEntries    TimeEntry[]
  attachments    Attachment[]
  activityLog    ActivityLog[]
  notes          Note[]
  savedFilters   SavedFilter[]
  ownedLetters   Letter[]        @relation("LetterOwner")
  ownedDocuments DocumentParty[] @relation("DocumentPartyOwner")
  reports        StatusReport[]  @relation("ReportAuthor")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Membership {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// ─── Проект ────────────────────────────────────────────────────────────────

enum ProjectState {
  PLANNED
  ACTIVE
  ON_HOLD
  DONE
  CANCELLED
}

model Project {
  id          String       @id @default(cuid())
  workspaceId String
  key         String // короткий код для номеров задач, напр. "CRM"
  name        String
  description String?
  state       ProjectState @default(PLANNED)
  color       String?

  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?

  taskCounter Int       @default(0) // источник номеров вида CRM-17
  archivedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  statuses      ProjectStatus[]
  milestones    Milestone[]
  members       ProjectMember[]
  tasks         Task[]
  fieldDefs     CustomFieldDef[]
  tracks        Track[]
  letters       Letter[]
  documents     Document[]
  reports       StatusReport[]
  cpMilestones  CounterpartyMilestone[]
  metrics       MetricSnapshot[]

  @@unique([workspaceId, key])
  @@index([workspaceId, state])
}

model ProjectMember {
  id        String @id @default(cuid())
  projectId String
  userId    String
  role      Role // переопределяет роль из Membership для этого проекта

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

enum StatusCategory {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

model ProjectStatus {
  id        String         @id @default(cuid())
  projectId String
  name      String
  category  StatusCategory
  color     String?
  position  Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([projectId, name])
  @@index([projectId, position])
}

model Milestone {
  id        String    @id @default(cuid())
  projectId String
  name      String
  dueDate   DateTime
  reachedAt DateTime?
  position  Int       @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, dueDate])
}

// ─── Задача ────────────────────────────────────────────────────────────────

enum Priority {
  LOWEST
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String  @id @default(cuid())
  workspaceId String // денормализовано: почти все выборки идут по пространству
  projectId   String
  number      Int // номер внутри проекта, вместе с Project.key даёт "CRM-17"
  title       String
  description String?

  statusId    String
  priority    Priority @default(MEDIUM)
  parentId    String?
  milestoneId String?
  trackId     String?
  counterpartyId String?

  // Внешний ответственный на стороне контрагента: сотрудников контрагента
  // в системе не заводят, поэтому имя хранится текстом.
  externalAssignee String?

  // Производственный трек ведётся в Jira; здесь только ключ задачи.
  jiraKey String?

  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?
  dueDate      DateTime? // срок, обещанный заказчику

  estimateHours Decimal? @db.Decimal(8, 2)
  loggedHours   Decimal  @default(0) @db.Decimal(10, 2) // агрегат из TimeEntry
  progress      Int      @default(0) // 0..100, ставится вручную

  sortOrder   Decimal @default(0) @db.Decimal(20, 10)
  createdById String

  customFields Json      @default("{}")
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status       ProjectStatus    @relation(fields: [statusId], references: [id])
  track        Track?           @relation(fields: [trackId], references: [id], onDelete: SetNull)
  counterparty Counterparty?    @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  notes        Note[]
  letters      LetterTask[]
  documents    DocumentTask[]
  parent       Task?            @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Task[]           @relation("TaskHierarchy")
  milestone    Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  createdBy    User             @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignees    TaskAssignee[]
  labels       TaskLabel[]
  comments     Comment[]
  attachments  Attachment[]
  timeEntries  TimeEntry[]
  dependsOn    TaskDependency[] @relation("DependencyTo")
  dependedOnBy TaskDependency[] @relation("DependencyFrom")

  @@unique([projectId, number])
  @@index([projectId, statusId, sortOrder])
  @@index([workspaceId, dueDate])
  @@index([parentId])
  @@index([milestoneId])
  @@index([trackId])
  @@index([counterpartyId])
  @@index([jiraKey])
}

model TaskAssignee {
  taskId    String
  userId    String
  isPrimary Boolean  @default(false)
  addedAt   DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId, taskId])
}

enum DependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

model TaskDependency {
  id         String         @id @default(cuid())
  fromTaskId String // предшественник
  toTaskId   String // зависимая задача
  type       DependencyType @default(FINISH_TO_START)
  lagDays    Int            @default(0)
  createdAt  DateTime       @default(now())

  fromTask Task @relation("DependencyFrom", fields: [fromTaskId], references: [id], onDelete: Cascade)
  toTask   Task @relation("DependencyTo", fields: [toTaskId], references: [id], onDelete: Cascade)

  @@unique([fromTaskId, toTaskId])
  @@index([toTaskId])
}

model Label {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  color       String

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([workspaceId, name])
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

// ─── Обсуждение, файлы, время ──────────────────────────────────────────────

model Comment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  editedAt  DateTime?
  createdAt DateTime  @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model Attachment {
  id           String   @id @default(cuid())
  taskId       String
  uploadedById String
  fileName     String
  contentType  String
  sizeBytes    Int
  storageKey   String // ключ объекта в S3-совместимом хранилище
  createdAt    DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
}

model TimeEntry {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  date      DateTime @db.Date
  hours     Decimal  @db.Decimal(6, 2)
  note      String?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId, date])
}

// ─── Пользовательские поля и журнал ────────────────────────────────────────

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  CHECKBOX
  USER
}

model CustomFieldDef {
  id          String          @id @default(cuid())
  workspaceId String
  projectId   String? // null — поле доступно во всём пространстве
  key         String // ключ внутри Task.customFields
  name        String
  type        CustomFieldType
  options     Json? // варианты для SELECT / MULTI_SELECT
  required    Boolean         @default(false)
  position    Int             @default(0)
  createdAt   DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, projectId, key])
}

model ActivityLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  entityType  String // "Task" | "Project" | "Milestone" | ...
  entityId    String
  action      String // "created" | "updated" | "deleted" | "commented"
  field       String?
  oldValue    Json?
  newValue    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([workspaceId, createdAt])
}

// ─── Треки работ ───────────────────────────────────────────────────────────
// Официальный, юридический, производственный, аналитический и т.д.
// По трекам разделяется ответственность и собирается отчёт руководству.

model Track {
  id        String  @id @default(cuid())
  projectId String
  name      String
  color     String?
  position  Int     @default(0)

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks    Task[]
  sections ReportSection[]

  @@unique([projectId, name])
}

// ─── Контрагенты ───────────────────────────────────────────────────────────

model Counterparty {
  id          String   @id @default(cuid())
  workspaceId String
  name        String // каноничное название
  shortName   String?
  isInternal  Boolean  @default(false) // собственное подразделение
  createdAt   DateTime @default(now())

  workspace  Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  aliases    CounterpartyAlias[]
  tasks      Task[]
  letters    Letter[]
  documents  Document[]
  parties    DocumentParty[]
  milestones CounterpartyMilestone[]

  @@unique([workspaceId, name])
}

// Варианты написания организации, встреченные в таблицах и письмах.
// Нужны, чтобы импорт схлопывал «ПАО "ФСК Россети"» и «ПАО Россети МР»
// в одну организацию, иначе отчёт по контрагенту не собирается.
model CounterpartyAlias {
  id             String @id @default(cuid())
  counterpartyId String
  alias          String

  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@unique([counterpartyId, alias])
  @@index([alias])
}

// ─── Переписка (ЭДО) ───────────────────────────────────────────────────────

enum LetterDirection {
  INCOMING
  OUTGOING
}

enum LetterStatus {
  DRAFT // готовится
  SENT // отправлено
  IN_PROGRESS // в работе
  UNDER_REVIEW // ответ на согласовании
  ANSWERED // дан ответ
  SIGNED // подписано
  NOTED // принято к сведению
  CLOSED_NO_ACTION // ответ не требуется
}

model Letter {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String

  number    String // номер письма, напр. 64-01-16906/26
  letterDate DateTime @db.Date
  subject   String
  direction LetterDirection
  status    LetterStatus    @default(IN_PROGRESS)

  counterpartyId String?
  ownerId        String? // ответственный за отработку письма

  externalUrl String? // карточка в системе ЭДО
  dueDate     DateTime? @db.Date // срок исполнения

  // Реквизиты ответного письма: номер и дата, как их пишут в реестре.
  // Отдельным текстом, потому что ответ может быть не заведён в системе.
  responseRequisites String?
  // Ответ как письмо в системе, когда он заведён.
  responseToId String?

  jiraKey String?
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  counterparty Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  owner        User?         @relation("LetterOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  responseTo   Letter?       @relation("LetterThread", fields: [responseToId], references: [id], onDelete: SetNull)
  responses    Letter[]      @relation("LetterThread")

  tasks     LetterTask[]
  basisFor  DocumentParty[] @relation("PartyBasisLetter")
  notes     Note[]

  // Просрочка НЕ хранится: считается как dueDate < today при незакрытом статусе.
  // В исходной таблице она записана текстом и устаревает в тот же день.

  @@unique([projectId, number, direction])
  @@index([projectId, dueDate])
  @@index([counterpartyId])
  @@index([projectId, letterDate])
}

model LetterTask {
  letterId String
  taskId   String

  letter Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([letterId, taskId])
  @@index([taskId])
}

// ─── Юридически значимые документы и подписание ────────────────────────────

enum DocumentKind {
  REGULATION // регламент информационного взаимодействия
  NDA
  NDA_ANNEX // дополнительное соглашение к NDA
  CONTRACT
  ACT
  OTHER
}

enum DocumentState {
  DRAFT
  SENT
  UNDER_REVIEW
  PARTIALLY_SIGNED
  SIGNED
  REJECTED
  CANCELLED
}

model Document {
  id        String @id @default(cuid())
  projectId String

  kind  DocumentKind
  title String

  // Организация, вокруг которой документ: в исходных реестрах строка — это РСО.
  counterpartyId String?

  // Состояние выводится из статусов сторон и пересчитывается при их изменении.
  // Хранится денормализованно, чтобы реестр документов читался одним запросом.
  state DocumentState @default(DRAFT)

  // Явно зафиксированный исход, который перебивает вывод из сторон.
  // Нужен потому, что в реестре «ДС к NDA» сторон по колонкам нет вообще, а
  // отказ записан только итоговой формулировкой: вывод из сторон дал бы там
  // «черновик» или «подписан частично» при фактическом отказе.
  // Это исключение, а не обычный путь: заполняется при импорте такой строки
  // или руками, когда человек фиксирует исход вопреки статусам сторон.
  stateOverride       DocumentState?
  stateOverrideReason String?

  // Стадия работы инициатора: «Заслан», «Отправлен», «в работе».
  // Это НЕ подпись. В реестре регламентов рядом стоят «Статус ДИТ» (стадия) и
  // «Статус подписания ДИТ» (подпись); разбирать обе как стороны — значит
  // получить дубль стороны. Сторону создаёт только колонка со словом
  // «подписания», стадия ложится сюда.
  originatorStage String?

  // «Статус согласования» — сводная оценка согласования из реестра.
  approvalNote String?

  // «Итоговый статус подписания» как он записан в реестре. Хранится текстом,
  // потому что несёт больше, чем состояние: «Подписан, экземпляр передан в
  // РСО» фиксирует передачу экземпляра, которой в статусах сторон нет.
  finalStatusText String?

  // Свободный текст «актуальный статус» из исходного реестра: там пишут
  // пояснение вроде «в наличии в 3 экз.», которое не выводится из статусов.
  stateNote String?

  integrationDueDate DateTime? @db.Date // срок интеграции, факт
  signedAt           DateTime? @db.Date
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  counterparty Counterparty?  @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  parties      DocumentParty[]
  tasks        DocumentTask[]
  notes        Note[]

  @@index([projectId, kind, state])
  @@index([counterpartyId])
}

// Статусы стороны. В исходных реестрах колонки «Статус подписания <сторона>»
// и «Статус согласования» дают NOT_SENT, AGREED, SIGNED и REFUSED; SENT и
// UNDER_REVIEW в файле не встречаются, но нужны для работы в системе.
//
// Важно: слова «Заслан» и «Отправлен» из колонки «Статус ДИТ» стороной НЕ
// являются — это стадия работы инициатора, она живёт в
// Document.originatorStage. Разбор обеих колонок как сторон даёт дубль ДИТ.
enum PartyStatus {
  NOT_SENT // «Нет»
  SENT // ушло стороне, ответа пока нет
  UNDER_REVIEW // на рассмотрении
  AGREED // «Согласован»
  SIGNED // «Подписан»
  REFUSED // «Не согласован РСО», отказ; причина обязательна
}

// Сторона подписания. В исходном реестре это отдельные колонки «Статус
// подписания ДИТ / РСО / ДЖКХ» — три независимых статуса у одного документа.
// Линейным статусом это не описывается, поэтому стороны вынесены в таблицу.
model DocumentParty {
  id         String @id @default(cuid())
  documentId String

  counterpartyId String // кто подписывает
  role           String? // роль в подписании: инициатор, согласующий, утверждающий
  position       Int     @default(0)

  status         PartyStatus @default(NOT_SENT)
  refusalReason  String? // обязателен при status = REFUSED (проверяется в домене)
  sentAt         DateTime?   @db.Date
  respondedAt    DateTime?   @db.Date
  signedAt       DateTime?   @db.Date

  // Письмо-основание: чем документ ушёл стороне или чем она ответила.
  basisLetterId String?
  ownerId       String? // ответственный за продвижение у этой стороны
  comment       String?

  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id])
  basisLetter  Letter?      @relation("PartyBasisLetter", fields: [basisLetterId], references: [id], onDelete: SetNull)
  owner        User?        @relation("DocumentPartyOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([documentId, counterpartyId])
  @@index([documentId, position])
}

model DocumentTask {
  documentId String
  taskId     String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([documentId, taskId])
  @@index([taskId])
}

// ─── График интеграций: вехи по контрагенту ────────────────────────────────
// Матрица «контрагент × этап»: строка реестра — организация, колонка — этап.
// Вехами проекта это не выражается.

model CounterpartyMilestone {
  id             String @id @default(cuid())
  projectId      String
  counterpartyId String

  stage       String // «Регламент отправлен», «Интеграция в dev» и т.д.
  position    Int       @default(0)
  plannedDate DateTime? @db.Date
  actualDate  DateTime? @db.Date
  comment     String?

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@unique([projectId, counterpartyId, stage])
  @@index([projectId, plannedDate])
}

// ─── Датированные записи ───────────────────────────────────────────────────
// В исходных таблицах колонка «Статус» содержит хронику с датами, а не
// состояние. Лента записей — то место, куда эта хроника переезжает без потерь.

model Note {
  id       String @id @default(cuid())
  authorId String?

  taskId     String?
  letterId   String?
  documentId String?

  body String

  // Дата события задаётся пользователем: событие было пятого, записали седьмого.
  // При импорте сюда попадает дата, распарсенная из текста ячейки.
  occurredOn DateTime @db.Date
  createdAt  DateTime @default(now())

  author   User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  task     Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  letter   Letter?   @relation(fields: [letterId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([taskId, occurredOn])
  @@index([letterId, occurredOn])
  @@index([documentId, occurredOn])
}

// ─── Отчёт руководству ─────────────────────────────────────────────────────

enum ReportState {
  DRAFT // собран системой, правится руками
  SUBMITTED // отправлен, дальше только чтение
}

// Снимок за период. После отправки замораживается: иначе через неделю отчёт
// покажет не то, что ушло руководству, и сверить его будет нельзя.
model StatusReport {
  id        String @id @default(cuid())
  projectId String

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  state       ReportState @default(DRAFT)

  // Шапка отчёта: руководитель, наличие контракта, ближайший релиз,
  // план развития. В исходной таблице это отдельные колонки.
  projectLead    String?
  contractStatus String?
  nextRelease    String?
  developmentPlan String?

  authorId    String?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author   User?           @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  sections ReportSection[]

  @@unique([projectId, periodStart, periodEnd])
  @@index([projectId, periodEnd])
}

// Раздел отчёта по треку. Текст собирается системой из задач за период,
// затем правится руками — «блокеры» и «предлагаемые решения» это аналитика,
// а не выборка.
model ReportSection {
  id       String @id @default(cuid())
  reportId String
  trackId  String?

  title          String
  doneText       String? // выполнено за период
  blockersText   String? // текущие блокеры
  solutionsText  String? // предлагаемые решения: кто и когда устраняет
  plannedText    String? // план на следующий период
  responsible    String? // ответственные за заполнение раздела
  position       Int     @default(0)

  report StatusReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  track  Track?       @relation(fields: [trackId], references: [id], onDelete: SetNull)

  @@index([reportId, position])
}

// ─── Поиск и фильтрация ────────────────────────────────────────────────────
// Полнотекстовый поиск и поиск по фрагменту номера реализованы в SQL:
// генерируемые колонки tsvector и индексы pg_trgm живут в отдельной миграции
// (Prisma не описывает генерируемые колонки). См. docs/search-and-analytics.md.

enum FilterSubject {
  LETTER
  TASK
  DOCUMENT
}

// Сохранённый набор условий: «мои просроченные письма по ДЖКХ»,
// «документы, где ждём сторону». Личный или общий на пространство.
model SavedFilter {
  id          String @id @default(cuid())
  workspaceId String
  ownerId     String? // null — общий фильтр пространства

  subject  FilterSubject
  name     String
  isPinned Boolean @default(false) // закреплён в боковой панели
  position Int     @default(0)

  // Дерево условий: { op: "and", children: [{ field, operator, value }, ...] }
  // Поля и операторы валидируются zod-схемой в packages/shared, чтобы
  // сохранённый фильтр нельзя было превратить в произвольный запрос.
  definition Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, ownerId, subject, name])
  @@index([workspaceId, subject, position])
}

// ─── Производственный календарь ────────────────────────────────────────────
// Нерабочие дни нужны, чтобы срок «десять рабочих дней» считался правильно:
// для официальной переписки сроки исчисляются в рабочих днях.

model NonWorkingDay {
  id          String @id @default(cuid())
  workspaceId String
  date        DateTime @db.Date
  name        String? // «Новогодние каникулы», «Перенос рабочего дня»
  isWorkingDay Boolean @default(false) // true — рабочая суббота из переноса

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date])
  @@index([workspaceId, date])
}

// ─── Аналитика ─────────────────────────────────────────────────────────────

// Суточный срез метрики. Текущие значения считаются запросом по живым данным
// (объёмы это позволяют), а снимки нужны только для графиков динамики:
// восстановить «сколько было просрочено месяц назад» по журналу изменений
// дороже и менее надёжно, чем записать значение в тот день.
model MetricSnapshot {
  id        String @id @default(cuid())
  projectId String

  capturedOn DateTime @db.Date
  metric     String // «letters.overdue», «documents.awaiting_party», «tasks.done»

  // Разрез метрики: контрагент, трек, исполнитель. null — значение по проекту.
  dimension      String?
  dimensionValue String?

  value Decimal @db.Decimal(14, 2)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, capturedOn, metric, dimension, dimensionValue])
  @@index([projectId, metric, capturedOn])
}

# Путь к базе. SQLite достаточно для команды до ~20 человек и не требует
# отдельного сервера. Относительный путь считается от корня проекта.
DATABASE_URL="file:./prisma/dev.db"

# Cookie входа с флагом Secure. По умолчанию он включён в продакшене, и тогда
# вход работает только по HTTPS: без шифрования браузер такую cookie отбросит.
# Если систему ставят во внутренней сети по обычному http, поставьте здесь
# false — иначе войти будет нельзя. По возможности выбирайте HTTPS: вместе с
# cookie по сети открыто пойдут и пароли.
# SESSION_COOKIE_SECURE=false

# Каталог с вложениями. По умолчанию var/attachments в корне проекта; на
# сервере укажите отдельный каталог и включите его в резервное копирование
# вместе с файлом базы. Предел размера файла — 20 МБ.
# ATTACHMENTS_DIR=/var/lib/tasktracker/attachments
